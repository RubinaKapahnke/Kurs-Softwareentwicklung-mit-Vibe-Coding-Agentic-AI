{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoot.local/schemas/courses.catalog.schema.json",
  "title": "Courses Catalog",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "status",
      "defaultModuleId",
      "moduleIds",
      "language",
      "version"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": { "type": "string", "minLength": 3 },
      "status": { "type": "string", "enum": ["live", "coming-soon", "archived"] },
      "defaultModuleId": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "moduleIds": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "uniqueItems": true
      },
      "language": { "type": "string", "minLength": 2 },
      "version": { "type": "integer", "minimum": 1 }
    }
  }
}
