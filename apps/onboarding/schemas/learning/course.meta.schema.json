{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoot.local/schemas/course.meta.schema.json",
  "title": "Course Meta",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "shortTitle", "audience", "outcome", "owners", "version"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "shortTitle": { "type": "string", "minLength": 3 },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 }
    },
    "outcome": { "type": "string", "minLength": 10 },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "version": { "type": "integer", "minimum": 1 }
  }
}
