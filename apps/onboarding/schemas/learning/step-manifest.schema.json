{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knoot.local/schemas/step-manifest.schema.json",
  "title": "Step Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "steps", "version"],
  "properties": {
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "slug", "title", "required", "sections"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": { "type": "string", "minLength": 3 },
          "required": { "type": "boolean" },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "file"],
              "properties": {
                "type": { "type": "string", "enum": ["lesson", "tasks", "übung"] },
                "file": { "type": "string", "minLength": 3 }
              }
            }
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": { "type": "string", "minLength": 2 },
                "href": { "type": "string", "minLength": 4 }
              }
            }
          },
          "prerequisites": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1 },
            "uniqueItems": true
          },
          "visibilityRule": {
            "type": "string",
            "enum": ["always", "gated", "conditional"]
          },
          "completionMode": {
            "type": "string",
            "enum": ["lesson-only", "tasks-only", "lesson-and-tasks"]
          },
          "featureFlags": {
            "type": "array",
            "items": { "type": "string", "minLength": 2 },
            "uniqueItems": true
          }
        }
      }
    },
    "deprecatedStepIds": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "version": { "type": "integer", "minimum": 1 }
  }
}
