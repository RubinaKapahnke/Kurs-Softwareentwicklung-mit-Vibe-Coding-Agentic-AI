{
  "name": "onboarding",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "sync-content": "node sync-content.mjs",
    "prestart": "npm run sync-content",
    "start": "ng serve",
    "prebuild": "npm run sync-content",
    "build": "ng build",
    "prewatch": "npm run sync-content",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/animations": "^21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.9",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@types/markdown-it": "^14.1.2",
    "canvas-confetti": "^1.9.4",
    "dompurify": "^3.0.8",
    "markdown-it": "^14.1.1",
    "marked": "^12.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.3",
    "@angular/cli": "^21.0.3",
    "@angular/compiler-cli": "^21.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
